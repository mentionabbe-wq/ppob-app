APP_NAME="PPOB App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ppob
DB_USERNAME=ppob
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ppob.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# ── Aplikasi ───────────────────────────────────────────
PPOB_OTP_TTL_MINUTES=10
PPOB_OTP_MAX_ATTEMPT=5
PPOB_DEPOSIT_MIN=10000
PPOB_DEPOSIT_MAX=10000000
PPOB_DEPOSIT_EXPIRE_HOURS=24
PPOB_DEFAULT_MARGIN_TYPE=fixed
PPOB_DEFAULT_MARGIN_VALUE=1000
PPOB_AUTO_APPROVE_DEPOSIT=false

# ── Provider: Digiflazz ────────────────────────────────
DIGIFLAZZ_ENABLED=true
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=
DIGIFLAZZ_ALLOWED_IPS=

# ── Provider: VIP Reseller ─────────────────────────────
VIPRESELLER_ENABLED=false
VIPRESELLER_BASE_URL=https://vip-reseller.co.id/api
VIPRESELLER_API_ID=
VIPRESELLER_API_KEY=

# ── Payment Gateway (VA / QRIS / e-wallet) ─────────────
PAYMENT_GATEWAY=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── Firebase Cloud Messaging ───────────────────────────
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=storage/app/firebase/service-account.json

# ── Google Sign-In (opsional) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8080/api/v1
